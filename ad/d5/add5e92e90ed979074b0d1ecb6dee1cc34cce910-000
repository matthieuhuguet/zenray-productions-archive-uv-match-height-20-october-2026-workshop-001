// 20 October 2026, 15:05 CEST: verify the rendered article and capture its real opening without using a personal browser.
import fs from 'node:fs/promises'
import path from 'node:path'
import os from 'node:os'
import { fileURLToPath } from 'node:url'
const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..')
const P = { url:process.env.ARTICLE_URL || 'http://127.0.0.1:4199/', desktop:{width:1400,height:1000},mobile:{width:390,height:844},cover:{width:1280,height:720},coverWidth:360,
  playwright:'/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/node_modules/@playwright/test/index.mjs' }
const {chromium}=await import(P.playwright)
const cache=path.join(os.homedir(),'Library/Caches/ms-playwright')
const versions=(await fs.readdir(cache)).filter(name=>/^chromium_headless_shell-\d+$/.test(name)).sort((a,b)=>Number(a.split('-').at(-1))-Number(b.split('-').at(-1)))
const executablePath=process.env.ARTICLE_BROWSER || path.join(cache,versions.at(-1),'chrome-headless-shell-mac-arm64/chrome-headless-shell')
const browser=await chromium.launch({headless:true,executablePath})
const proof={}
const definition=JSON.parse(await fs.readFile(path.join(ROOT,'Drafts/Article/Article-20-October-2026.json'),'utf8'))
const expected={sections:definition.sections.length,prompts:definition.sections.reduce((total,section)=>total+(section.prompts?.length||0),0)}
try {
  const page=await browser.newPage({viewport:P.desktop,colorScheme:'light'})
  const errors=[];page.on('pageerror',e=>errors.push(e.message))
  await page.goto(P.url,{waitUntil:'networkidle'})
  await page.evaluate(async()=>{for(const img of document.images)img.loading='eager';await Promise.all([...document.images].map(img=>img.decode()));await document.fonts.ready})
  proof.desktop=await page.evaluate(()=>({title:document.title,sections:document.querySelectorAll('main>section').length,prompts:document.querySelectorAll('.prompt-text').length,images:[...document.images].every(img=>img.complete&&img.naturalWidth>0),brokenAnchors:[...document.querySelectorAll('a[href^="#"]')].map(a=>a.hash.slice(1)).filter(id=>!document.getElementById(id)),overflow:document.documentElement.scrollWidth>innerWidth,serif:document.fonts.check('500 19px "AnthropicSerif Medium"'),chatgpt:!!document.querySelector('a[href="https://chatgpt.com"]')}))
  await page.screenshot({path:path.join(ROOT,'Drafts/Article/ArticleOpening-20-October-2026.png')})
  await page.setViewportSize(P.mobile)
  proof.mobile={overflow:await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth)}
  await page.screenshot({path:path.join(ROOT,'Verification/ArticleMobile-20-October-2026.png')})
  const cover=await browser.newContext({viewport:P.cover,deviceScaleFactor:P.coverWidth/P.cover.width,colorScheme:'light'})
  const front=await cover.newPage();await front.goto(P.url,{waitUntil:'networkidle'});await front.evaluate(()=>document.fonts.ready)
  await front.screenshot({path:path.join(ROOT,'Drafts/Article/ArticleCover-20-October-2026.jpg'),type:'jpeg',quality:85})
  proof.cover={width:P.coverWidth,bytes:(await fs.stat(path.join(ROOT,'Drafts/Article/ArticleCover-20-October-2026.jpg'))).size}
  proof.errors=errors
  proof.ok=proof.desktop.sections===expected.sections&&proof.desktop.prompts===expected.prompts&&proof.desktop.images&&!proof.desktop.brokenAnchors.length&&!proof.desktop.overflow&&!proof.mobile.overflow&&proof.desktop.serif&&proof.desktop.chatgpt&&!errors.length
  await fs.writeFile(path.join(ROOT,'Verification/ArticleCheck-20-October-2026.json'),JSON.stringify(proof,null,2)+'\n')
  console.log(JSON.stringify(proof))
  if(!proof.ok)process.exitCode=1
} finally {await browser.close()}
