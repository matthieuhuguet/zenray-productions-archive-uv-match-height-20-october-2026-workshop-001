def prompts(value):
    return [prompt['text'] for section in value['sections'] for prompt in section.get('prompts', [])]

def prose_words(value):
    text = ' '.join(str(value.get(key, '')) for key in ['lead', 'heroText', 'heroCaption', 'footer'])
    for section in value['sections']:
        text += ' ' + section.get('html', '') + ' ' + ' '.join(figure['caption'] for figure in section.get('figures', []))
    return len(re.sub('<[^>]+>', ' ', text).split())

assert prompts(original) == prompts(article), 'Prompts must remain intact'
